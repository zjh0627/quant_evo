// =============================================
// Quant Evo 数据层 Schema 初始化脚本 (复合分区版)
// 生成时间: 2026-07-14
//
// 复合分区策略:
// - 日线表: COMPOUND (VALUE on trade_date, HASH on security_id)
// - 分钟表: COMPOUND (VALUE on trade_time, HASH on security_id)
// - 财务表: COMPOUND (VALUE on report_date, HASH on security_id)
// - 因子表: COMPOUND (VALUE on trade_date/trade_time, HASH on security_id)
//
// 优点:
// 1. 按日期分区可以快速定位到某天的数据
// 2. HASH 分区可以将数据分散到多个分区，减少单分区数据量
// 3. 支持高效的多维度查询
// =============================================

// 数据库路径定义
MARKET_DB = "dfs://quant_evo_market"
METADATA_DB = "dfs://quant_evo_metadata"
FACTORS_DB = "dfs://quant_evo_factors"

// HASH 分区数量 (建议 8-16 个，视数据量而定)
HASH_PARTITIONS = 8

// =============================================
// Layer 1: 基础行情层 - 复合分区
// =============================================

// ---------- 日线行情表 (daily_k) ----------
// 分区: COMPOUND (VALUE on trade_date + HASH on security_id)
if(existsDatabase(MARKET_DB)) {
    dropDatabase(MARKET_DB)
}

// 创建复合分区数据库
db_date = database(, VALUE, 2020.01.01..2030.01.01)
db_hash = database(, HASH, [SYMBOL, HASH_PARTITIONS])
db = database(MARKET_DB, COMPOUND, [db_date, db_hash])

schema_daily = table(100:0,
    `trade_date`security_id`open`high`low`close`volume`amount`turn`pct_chg`is_suspended`is_limit_up`is_limit_down`pre_close`adj_factor,
    [DATE, SYMBOL, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, BOOL, BOOL, BOOL, DOUBLE, DOUBLE]
)

// 创建分区表 - 使用 trade_date 作为分区列
t_daily = createPartitionedTable(db, schema_daily, "daily_k", `trade_date)
print("Created table: daily_k (COMPOUND partition)")

// ---------- 1分钟K线表 (min_1k) ----------
// 分区: COMPOUND (VALUE on trade_time + HASH on security_id)
db_time = database(, VALUE, 2020.01.01T00:00:00..2030.01.01T00:00:00)
db_hash = database(, HASH, [SYMBOL, HASH_PARTITIONS])
db_min = database(MARKET_DB + "/min_1k", COMPOUND, [db_time, db_hash])

schema_min1 = table(100:0,
    `trade_time`security_id`open`high`low`close`volume`amount,
    [TIMESTAMP, SYMBOL, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE]
)
t_min1 = createPartitionedTable(db_min, schema_min1, "min_1k", `trade_time)
print("Created table: min_1k (COMPOUND partition)")

// ---------- 5分钟K线表 (min_5k) ----------
db_time5 = database(, VALUE, 2020.01.01T00:00:00..2030.01.01T00:00:00)
db_hash5 = database(, HASH, [SYMBOL, HASH_PARTITIONS])
db_min5 = database(MARKET_DB + "/min_5k", COMPOUND, [db_time5, db_hash5])

schema_min5 = table(100:0,
    `trade_time`security_id`open`high`low`close`volume`amount,
    [TIMESTAMP, SYMBOL, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE]
)
t_min5 = createPartitionedTable(db_min5, schema_min5, "min_5k", `trade_time)
print("Created table: min_5k (COMPOUND partition)")

// ---------- 15分钟K线表 (min_15k) ----------
db_time15 = database(, VALUE, 2020.01.01T00:00:00..2030.01.01T00:00:00)
db_hash15 = database(, HASH, [SYMBOL, HASH_PARTITIONS])
db_min15 = database(MARKET_DB + "/min_15k", COMPOUND, [db_time15, db_hash15])

schema_min15 = table(100:0,
    `trade_time`security_id`open`high`low`close`volume`amount,
    [TIMESTAMP, SYMBOL, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE]
)
t_min15 = createPartitionedTable(db_min15, schema_min15, "min_15k", `trade_time)
print("Created table: min_15k (COMPOUND partition)")


// =============================================
// Layer 2: 辅助因子层 - 复合分区
// =============================================

// ---------- 财务数据表 (fundamental) ----------
if(existsDatabase(METADATA_DB)) {
    dropDatabase(METADATA_DB)
}

db_report = database(, VALUE, 2020.01.01..2030.01.01)
db_meta_hash = database(, HASH, [SYMBOL, HASH_PARTITIONS])
db_meta = database(METADATA_DB, COMPOUND, [db_report, db_meta_hash])

schema_fund = table(100:0,
    `report_date`security_id`pe_ttm`pe_ltm`pb`ps_ttm`pcf`roe`roa`gross_margin`net_margin`debt_ratio`current_ratio`quick_ratio`total_revenue`net_profit`operating_cf`investing_cf`financing_cf,
    [DATE, SYMBOL, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE]
)
t_fund = createPartitionedTable(db_meta, schema_fund, "fundamental", `report_date)
print("Created table: fundamental (COMPOUND partition)")

// ---------- 市场标记表 (market_flag) ----------
db_trade = database(, VALUE, 2020.01.01..2030.01.01)
db_flag_hash = database(, HASH, [SYMBOL, HASH_PARTITIONS])
db_flag = database(METADATA_DB + "/market_flag", COMPOUND, [db_trade, db_flag_hash])

schema_flag = table(100:0,
    `trade_date`security_id`is_st`is_new`is_hs300`is_zz500`is_zz1000`industry`market_cap`float_cap`total_shares`float_shares,
    [DATE, SYMBOL, BOOL, BOOL, BOOL, BOOL, BOOL, STRING, DOUBLE, DOUBLE, DOUBLE, DOUBLE]
)
t_flag = createPartitionedTable(db_flag, schema_flag, "market_flag", `trade_date)
print("Created table: market_flag (COMPOUND partition)")


// =============================================
// Layer 3: 中间计算层 - 复合分区
// =============================================

// ---------- 日频因子表 (factor_daily) ----------
if(existsDatabase(FACTORS_DB)) {
    dropDatabase(FACTORS_DB)
}

db_factor_date = database(, VALUE, 2020.01.01..2030.01.01)
db_factor_hash = database(, HASH, [SYMBOL, HASH_PARTITIONS])
db_factor_d = database(FACTORS_DB, COMPOUND, [db_factor_date, db_factor_hash])

schema_factor_d = table(100:0,
    `trade_date`security_id`momentum_1d`momentum_5d`momentum_10d`momentum_20d`momentum_60d`volatility_5d`volatility_20d`vol_ratio_5_20`ma_5`ma_10`ma_20`ma_60`ma_bull`macd`macd_signal`macd_hist`volume_ratio`pv_corr`money_flow`rsi_6`rsi_12`rsi_24`bb_upper`bb_mid`bb_lower`bb_width`bb_position`atr_14`cci_14`composite_score`signal,
    [DATE, SYMBOL, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, INT, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, STRING]
)
t_factor_d = createPartitionedTable(db_factor_d, schema_factor_d, "factor_daily", `trade_date)
print("Created table: factor_daily (COMPOUND partition)")

// ---------- 分钟因子表 (factor_min) ----------
db_factor_time = database(, VALUE, 2020.01.01T00:00:00..2030.01.01T00:00:00)
db_factor_m_hash = database(, HASH, [SYMBOL, HASH_PARTITIONS])
db_factor_m = database(FACTORS_DB + "/factor_min", COMPOUND, [db_factor_time, db_factor_m_hash])

schema_factor_m = table(100:0,
    `trade_time`security_id`ma_5m`ma_10m`ma_20m`ma_60m`macd`macd_signal`macd_hist`kdj_k`kdj_d`kdj_j`rsi`bb_upper`bb_lower`bb_position`composite_score`signal,
    [TIMESTAMP, SYMBOL, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, STRING]
)
t_factor_m = createPartitionedTable(db_factor_m, schema_factor_m, "factor_min", `trade_time)
print("Created table: factor_min (COMPOUND partition)")


// =============================================
// 完成
// =============================================
print("========================================")
print("All tables created with COMPOUND partition!")
print("========================================")
print("Partition Strategy: COMPOUND")
print("  - VALUE on date/time (primary partition)")
print("  - HASH on security_id (secondary partition)")
print("  - Hash partitions: " + HASH_PARTITIONS)
print("")
print("Database: " + MARKET_DB)
print("  - daily_k (日线)")
print("  - min_1k (1分钟)")
print("  - min_5k (5分钟)")
print("  - min_15k (15分钟)")
print("")
print("Database: " + METADATA_DB)
print("  - fundamental (财务数据)")
print("  - market_flag (市场标记)")
print("")
print("Database: " + FACTORS_DB)
print("  - factor_daily (日频因子)")
print("  - factor_min (分钟因子)")
print("========================================")
